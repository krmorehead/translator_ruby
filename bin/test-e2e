#!/usr/bin/env bash
# frozen_string_literal: false

# E2E Test Runner Script
# Starts Rails backend in TEST mode and runs Playwright E2E tests
#
# Usage:
#   bin/test-e2e              # Run all E2E tests
#   bin/test-e2e fast         # Run only fast E2E tests
#   bin/test-e2e medium       # Run only medium E2E tests  
#   bin/test-e2e slow         # Run only slow E2E tests (with LLM)
#   bin/test-e2e --grep PATTERN  # Pass through to playwright

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo "======================================================================"
echo "E2E Test Suite Runner"
echo "======================================================================"
echo ""

# Parse speed filter argument
SPEED_FILTER=""
PLAYWRIGHT_ARGS=""

if [ "$1" == "fast" ] || [ "$1" == "medium" ] || [ "$1" == "slow" ]; then
  SPEED_FILTER="$1"
  shift
fi

# Remaining args pass through to playwright
PLAYWRIGHT_ARGS="$@"

# Project root
PROJECT_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$PROJECT_ROOT"

# Check if servers are already running
if lsof -i:4000 -t >/dev/null 2>&1; then
  echo -e "${YELLOW}⚠️  Rails server already running on port 4000${NC}"
  echo "   Will use existing server (make sure it's in TEST mode!)"
  RAILS_RUNNING=true
else
  RAILS_RUNNING=false
fi

if lsof -i:5173 -t >/dev/null 2>&1; then
  echo -e "${YELLOW}⚠️  Vite server already running on port 5173${NC}"
  echo "   Will use existing server"
  VITE_RUNNING=true
else
  VITE_RUNNING=false
fi

# Function to cleanup on exit
cleanup() {
  echo ""
  echo "======================================================================"
  echo "Cleaning up..."
  echo "======================================================================"
  
  if [ "$RAILS_RUNNING" == "false" ] && [ -n "$RAILS_PID" ]; then
    echo "Stopping Rails server (PID: $RAILS_PID)..."
    kill $RAILS_PID 2>/dev/null || true
    wait $RAILS_PID 2>/dev/null || true
  fi
  
  if [ "$VITE_RUNNING" == "false" ] && [ -n "$VITE_PID" ]; then
    echo "Stopping Vite server (PID: $VITE_PID)..."
    kill $VITE_PID 2>/dev/null || true
    wait $VITE_PID 2>/dev/null || true
  fi
  
  echo -e "${GREEN}✅ Cleanup complete${NC}"
}

trap cleanup EXIT INT TERM

# Start Rails in TEST environment if not already running
if [ "$RAILS_RUNNING" == "false" ]; then
  echo "Starting Rails server in TEST mode on port 4000..."
  RAILS_ENV=test bundle exec rails server -p 4000 > tmp/e2e_rails.log 2>&1 &
  RAILS_PID=$!
  
  echo "Waiting for Rails server to start..."
  for i in {1..30}; do
    if curl -s http://localhost:4000/api/sisyphus/config > /dev/null 2>&1; then
      echo -e "${GREEN}✅ Rails server ready${NC}"
      break
    fi
    if [ $i -eq 30 ]; then
      echo -e "${RED}❌ Rails server failed to start within 30 seconds${NC}"
      echo "Check tmp/e2e_rails.log for errors"
      exit 1
    fi
    sleep 1
  done
else
  echo -e "${GREEN}✅ Using existing Rails server${NC}"
fi

# Start Vite frontend if not already running
if [ "$VITE_RUNNING" == "false" ]; then
  echo "Starting Vite server on port 5173..."
  cd frontend
  npm run dev > ../tmp/e2e_vite.log 2>&1 &
  VITE_PID=$!
  cd ..
  
  echo "Waiting for Vite server to start..."
  for i in {1..30}; do
    if curl -s http://localhost:5173 > /dev/null 2>&1; then
      echo -e "${GREEN}✅ Vite server ready${NC}"
      break
    fi
    if [ $i -eq 30 ]; then
      echo -e "${RED}❌ Vite server failed to start within 30 seconds${NC}"
      echo "Check tmp/e2e_vite.log for errors"
      exit 1
    fi
    sleep 1
  done
else
  echo -e "${GREEN}✅ Using existing Vite server${NC}"
fi

echo ""
echo "======================================================================"
echo "Running E2E Tests"
if [ -n "$SPEED_FILTER" ]; then
  echo "Speed Filter: $SPEED_FILTER"
fi
echo "======================================================================"
echo ""

# Run Playwright tests
cd frontend/e2e

if [ -n "$SPEED_FILTER" ]; then
  # Use speed filter
  SKIP_WEBSERVER=1 TEST_SPEED_FILTER="$SPEED_FILTER" npx playwright test $PLAYWRIGHT_ARGS
else
  # Run all tests
  SKIP_WEBSERVER=1 npx playwright test $PLAYWRIGHT_ARGS
fi

TEST_EXIT_CODE=$?

echo ""
if [ $TEST_EXIT_CODE -eq 0 ]; then
  echo -e "${GREEN}======================================================================"
  echo "✅ All E2E tests passed!"
  echo "======================================================================${NC}"
else
  echo -e "${RED}======================================================================"
  echo "❌ E2E tests failed"
  echo "======================================================================${NC}"
fi

exit $TEST_EXIT_CODE

