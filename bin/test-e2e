#!/usr/bin/env bash
# frozen_string_literal: false

# E2E Test Runner Script
# Starts Rails backend in TEST mode and runs Playwright E2E tests
#
# Usage:
#   bin/test-e2e              # Run all E2E tests
#   bin/test-e2e fast         # Run only fast E2E tests
#   bin/test-e2e medium       # Run only medium E2E tests  
#   bin/test-e2e slow         # Run only slow E2E tests (with LLM)
#   bin/test-e2e --grep PATTERN  # Pass through to playwright

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo "======================================================================"
echo "E2E Test Suite Runner"
echo "======================================================================"
echo ""

# Parse speed filter argument
SPEED_FILTER=""
PLAYWRIGHT_ARGS=""

if [ "$1" == "fast" ] || [ "$1" == "medium" ] || [ "$1" == "slow" ]; then
  SPEED_FILTER="$1"
  shift
fi

# Remaining args pass through to playwright
PLAYWRIGHT_ARGS="$@"

# Project root
PROJECT_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$PROJECT_ROOT"

# Kill any existing process on port 4000 (ensure clean test environment)
if lsof -i:4000 -t >/dev/null 2>&1; then
  echo -e "${YELLOW}⚠️  Killing existing process on port 4000${NC}"
  lsof -i:4000 -t | xargs kill -9 2>/dev/null || true
  sleep 1
fi

# Function to cleanup on exit
cleanup() {
  echo ""
  echo "======================================================================"
  echo "Cleaning up..."
  echo "======================================================================"
  
  if [ -n "$RAILS_PID" ]; then
    echo "Stopping Rails server (PID: $RAILS_PID)..."
    kill $RAILS_PID 2>/dev/null || true
    wait $RAILS_PID 2>/dev/null || true
  fi
  
  echo -e "${GREEN}✅ Cleanup complete${NC}"
}

trap cleanup EXIT INT TERM

# Start Rails in TEST environment
echo "Starting Rails server in TEST mode on port 4000..."
LOG_LEVEL=debug RAILS_ENV=test bundle exec rails server -p 4000 > tmp/e2e_rails.log 2>&1 &
RAILS_PID=$!

echo "Waiting for Rails server to start..."
for i in {1..30}; do
  if curl -s http://localhost:4000/api/sisyphus/config > /dev/null 2>&1; then
    echo -e "${GREEN}✅ Rails server ready${NC}"
    break
  fi
  if [ $i -eq 30 ]; then
    echo -e "${RED}❌ Rails server failed to start within 30 seconds${NC}"
    echo "Check tmp/e2e_rails.log for errors"
    exit 1
  fi
  sleep 1
done

echo ""
echo "Note: Vite frontend will be managed by Playwright's webServer"

echo ""
echo "======================================================================"
echo "Running E2E Tests"
if [ -n "$SPEED_FILTER" ]; then
  echo "Speed Filter: $SPEED_FILTER"
fi
echo "======================================================================"
echo ""

# Run Playwright tests
cd frontend/e2e

# Playwright will manage Vite via webServer config, we manage Rails
if [ -n "$SPEED_FILTER" ]; then
  # Use speed filter
  TEST_SPEED_FILTER="$SPEED_FILTER" npx playwright test $PLAYWRIGHT_ARGS
else
  # Run all tests
  npx playwright test $PLAYWRIGHT_ARGS
fi

TEST_EXIT_CODE=$?

echo ""
if [ $TEST_EXIT_CODE -eq 0 ]; then
  echo -e "${GREEN}======================================================================"
  echo "✅ All E2E tests passed!"
  echo "======================================================================${NC}"
else
  echo -e "${RED}======================================================================"
  echo "❌ E2E tests failed"
  echo "======================================================================${NC}"
fi

exit $TEST_EXIT_CODE

