# Server Configuration
PORT=52020

# Database Configuration
DB_USERNAME=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# LLM Service Configuration
# Base URL for LLM services. The system will automatically route to different
# ports based on capability (general_llm: 52003, tool_calling: 52004)
LLM_URL=http://localhost:52003
API_KEY=your-api-key-here

# LLM configuration
LLM_REQUEST_TIMEOUT=60
LLM_RETRY_AT=3
LLM_RETRY_DELAY=100

# Note: LLM_MODEL is no longer used. Models are configured per capability in GenericLlmClient

# Rails Environment
RAILS_ENV=development

# Optional: Database URL (overrides individual DB settings if provided)
# DATABASE_URL=postgres://username:password@localhost:5432/translator_ruby_development
